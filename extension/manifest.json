{
  "manifest_version": 3,
  "name": "Final Layer Wallet",
  "version": "0.3.2",
  "description": "Non-custodial post-quantum (ML-DSA-87) wallet for the Final Layer blockchain.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Final Layer Wallet"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://207.148.16.239/*"
  ]
}